[Unit]
Description=S500 Pixhawk USB read-only telemetry recorder
After=multi-user.target

[Service]
Type=simple
User=s500
Group=dialout
WorkingDirectory=/opt/s500-companion
ExecStart=/opt/s500-companion/.venv/bin/s500-companion record --duration 31536000 --rate 5 --output /var/log/s500-companion/telemetry.csv
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/s500-companion

[Install]
WantedBy=multi-user.target

