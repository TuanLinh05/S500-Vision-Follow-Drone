<?xml version="1.0"?>
<sdf version="1.9">
  <model name="s500_quad_x">
    <!--
      Coordinate convention: FLU (+X forward, +Y left, +Z up).

      Initial engineering estimate, to be calibrated against the completed airframe:
        wheelbase (diagonal motor-to-motor): 0.500 m
        propeller diameter:                 0.240 m (DJI 9450)
        modeled take-off mass:              1.68 kg
        motor speed limit:                  1050 rad/s

      Motor order follows the PX4 quad-X convention used by the future SITL
      integration: 0 front-right, 1 rear-left, 2 front-left, 3 rear-right.
    -->
    <self_collide>false</self_collide>
    <allow_auto_disable>false</allow_auto_disable>

    <link name="base_link">
      <inertial>
        <mass>1.10</mass>
        <inertia>
          <ixx>0.018</ixx><iyy>0.021</iyy><izz>0.035</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <!-- Detailed S500 CAD frame, including the original CAD landing gear. -->
      <visual name="s500_cad_frame">
        <geometry>
          <mesh>
            <uri>model://s500_quad_x/meshes/s500_frame_full.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.025 0.028 0.035 1</ambient>
          <diffuse>0.075 0.080 0.095 1</diffuse>
          <specular>0.16 0.16 0.18 1</specular>
        </material>
      </visual>
      <visual name="battery_4s_6200mah">
        <pose>0 0 -0.085 0 0 0</pose>
        <geometry><box><size>0.145 0.052 0.052</size></box></geometry>
        <material><ambient>0.06 0.10 0.20 1</ambient><diffuse>0.10 0.20 0.40 1</diffuse></material>
      </visual>
      <visual name="pixhawk_6c">
        <pose>-0.020 0 0.067 0 0 0</pose>
        <geometry><box><size>0.070 0.045 0.018</size></box></geometry>
        <material><ambient>0.85 0.33 0.04 1</ambient><diffuse>1 0.46 0.06 1</diffuse></material>
      </visual>
      <visual name="gps_m10">
        <pose>-0.060 0 0.090 0 0 0</pose>
        <geometry><cylinder><radius>0.022</radius><length>0.010</length></cylinder></geometry>
        <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.92 0.92 0.92 1</diffuse></material>
      </visual>
      <visual name="mtf01_optical_flow_housing">
        <pose>0.045 0 -0.094 0 0 0</pose>
        <geometry><box><size>0.038 0.032 0.014</size></box></geometry>
        <material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.04 0.04 0.04 1</diffuse></material>
      </visual>
      <visual name="mtf01_lens">
        <pose>0.045 0 -0.104 0 0 0</pose>
        <geometry><cylinder><radius>0.008</radius><length>0.004</length></cylinder></geometry>
        <material><ambient>0.02 0.08 0.12 1</ambient><diffuse>0.03 0.18 0.30 1</diffuse></material>
      </visual>

      <collision name="centre_plate_collision">
        <geometry><box><size>0.225 0.205 0.075</size></box></geometry>
      </collision>
      <collision name="battery_collision">
        <pose>0 0 -0.085 0 0 0</pose>
        <geometry><box><size>0.145 0.052 0.052</size></box></geometry>
      </collision>

      <!-- The full CAD mesh above provides the landing gear visuals. -->
      <collision name="leg_collision">
        <pose>0 0 -0.055 0 0 0</pose>
        <geometry><box><size>0.400 0.400 0.200</size></box></geometry>
      </collision>

      <!-- The SDF has native IMU, barometer and GPS placeholders for PX4 SITL. -->
      <sensor name="imu_sensor" type="imu">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on><update_rate>250</update_rate>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <pose>-0.060 0 0.095 0 0 0</pose>
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on><update_rate>10</update_rate>
      </sensor>
      <sensor name="air_pressure_sensor" type="air_pressure">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on><update_rate>50</update_rate>
      </sensor>
      <sensor name="magnetometer_sensor" type="magnetometer">
        <gz_frame_id>base_link</gz_frame_id>
        <always_on>true</always_on><update_rate>100</update_rate>
      </sensor>
    </link>

    <!--
      MTF-01 simulation payload.  PX4's Gazebo bridge subscribes to these
      exact links: flow_link for optical flow and lidar_sensor_link for the
      downward range measurement.
    -->
    <link name="flow_link">
      <pose relative_to="base_link">0.045 0 -0.104 0 1.570796 0</pose>
      <inertial>
        <mass>0.015</mass>
        <inertia><ixx>0.000003</ixx><iyy>0.000003</iyy><izz>0.000004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="flow_camera" type="camera">
        <gz_frame_id>flow_link</gz_frame_id>
        <pose>0 0 0 0 1.5707 0</pose>
        <camera>
          <horizontal_fov>0.733038</horizontal_fov>
          <image><width>100</width><height>100</height></image>
          <clip><near>0.10</near><far>30.0</far></clip>
        </camera>
        <always_on>true</always_on><update_rate>50</update_rate><visualize>false</visualize>
      </sensor>
      <sensor name="optical_flow" type="custom" gz:type="optical_flow">
        <gz_frame_id>flow_link</gz_frame_id>
        <always_on>true</always_on><update_rate>50</update_rate><visualize>false</visualize>
      </sensor>
    </link>
    <joint name="mtf01_optical_flow_joint" type="fixed">
      <parent>base_link</parent><child>flow_link</child>
    </joint>

    <link name="lidar_sensor_link">
      <pose relative_to="base_link">0.045 0 -0.104 0 1.570796 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <sensor name="lidar" type="gpu_lidar">
        <gz_frame_id>lidar_sensor_link</gz_frame_id>
        <pose>0 0 0 3.141593 0 0</pose>
        <update_rate>50</update_rate>
        <ray>
          <scan>
            <horizontal><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></horizontal>
            <vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical>
          </scan>
          <range><min>0.10</min><max>8.0</max><resolution>0.01</resolution></range>
        </ray>
        <always_on>true</always_on><visualize>false</visualize>
      </sensor>
    </link>
    <joint name="mtf01_range_joint" type="fixed">
      <parent>base_link</parent><child>lidar_sensor_link</child>
    </joint>

    <!-- Arms: motor centres are (+/- 0.1768, +/- 0.1768) m: 500 mm diagonal. -->
    <link name="arm_front_right">
      <pose relative_to="base_link">0.0884 -0.0884 0.018 0 0 -0.785398</pose>
      <inertial><mass>0.060</mass><inertia><ixx>0.00015</ixx><iyy>0.00080</iyy><izz>0.00085</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.260 0.030 0.018</size></box></geometry></collision>
    </link>
    <link name="arm_rear_left">
      <pose relative_to="base_link">-0.0884 0.0884 0.018 0 0 2.356194</pose>
      <inertial><mass>0.060</mass><inertia><ixx>0.00015</ixx><iyy>0.00080</iyy><izz>0.00085</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.260 0.030 0.018</size></box></geometry></collision>
    </link>
    <link name="arm_front_left">
      <pose relative_to="base_link">0.0884 0.0884 0.018 0 0 0.785398</pose>
      <inertial><mass>0.060</mass><inertia><ixx>0.00015</ixx><iyy>0.00080</iyy><izz>0.00085</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.260 0.030 0.018</size></box></geometry></collision>
    </link>
    <link name="arm_rear_right">
      <pose relative_to="base_link">-0.0884 -0.0884 0.018 0 0 -2.356194</pose>
      <inertial><mass>0.060</mass><inertia><ixx>0.00015</ixx><iyy>0.00080</iyy><izz>0.00085</izz></inertia></inertial>
      <collision name="collision"><geometry><box><size>0.260 0.030 0.018</size></box></geometry></collision>
    </link>

    <joint name="arm_front_right_joint" type="fixed"><parent>base_link</parent><child>arm_front_right</child></joint>
    <joint name="arm_rear_left_joint" type="fixed"><parent>base_link</parent><child>arm_rear_left</child></joint>
    <joint name="arm_front_left_joint" type="fixed"><parent>base_link</parent><child>arm_front_left</child></joint>
    <joint name="arm_rear_right_joint" type="fixed"><parent>base_link</parent><child>arm_rear_right</child></joint>

    <!-- Rotor links carry a 9.45 inch propeller visual and spin about local +Z. -->
    <link name="rotor_front_right">
      <pose relative_to="base_link">0.176777 -0.176777 0.052 0 0 0</pose>
      <inertial><mass>0.050</mass><inertia><ixx>0.00010</ixx><iyy>0.00010</iyy><izz>0.00018</izz></inertia></inertial>
      <visual name="motor"><pose>0 0 -0.020 0 0 0</pose><geometry><cylinder><radius>0.018</radius><length>0.042</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
      <visual name="propeller"><pose>0 0 0.009 0 0 0</pose><geometry><cylinder><radius>0.120</radius><length>0.005</length></cylinder></geometry><material><ambient>0.10 0.10 0.11 0.80</ambient><diffuse>0.22 0.22 0.24 0.80</diffuse></material></visual>
    </link>
    <link name="rotor_rear_left">
      <pose relative_to="base_link">-0.176777 0.176777 0.052 0 0 0</pose>
      <inertial><mass>0.050</mass><inertia><ixx>0.00010</ixx><iyy>0.00010</iyy><izz>0.00018</izz></inertia></inertial>
      <visual name="motor"><pose>0 0 -0.020 0 0 0</pose><geometry><cylinder><radius>0.018</radius><length>0.042</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
      <visual name="propeller"><pose>0 0 0.009 0 0 0</pose><geometry><cylinder><radius>0.120</radius><length>0.005</length></cylinder></geometry><material><ambient>0.10 0.10 0.11 0.80</ambient><diffuse>0.22 0.22 0.24 0.80</diffuse></material></visual>
    </link>
    <link name="rotor_front_left">
      <pose relative_to="base_link">0.176777 0.176777 0.052 0 0 0</pose>
      <inertial><mass>0.050</mass><inertia><ixx>0.00010</ixx><iyy>0.00010</iyy><izz>0.00018</izz></inertia></inertial>
      <visual name="motor"><pose>0 0 -0.020 0 0 0</pose><geometry><cylinder><radius>0.018</radius><length>0.042</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
      <visual name="propeller"><pose>0 0 0.009 0 0 0</pose><geometry><cylinder><radius>0.120</radius><length>0.005</length></cylinder></geometry><material><ambient>0.10 0.10 0.11 0.80</ambient><diffuse>0.22 0.22 0.24 0.80</diffuse></material></visual>
    </link>
    <link name="rotor_rear_right">
      <pose relative_to="base_link">-0.176777 -0.176777 0.052 0 0 0</pose>
      <inertial><mass>0.050</mass><inertia><ixx>0.00010</ixx><iyy>0.00010</iyy><izz>0.00018</izz></inertia></inertial>
      <visual name="motor"><pose>0 0 -0.020 0 0 0</pose><geometry><cylinder><radius>0.018</radius><length>0.042</length></cylinder></geometry><material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.18 0.18 0.20 1</diffuse></material></visual>
      <visual name="propeller"><pose>0 0 0.009 0 0 0</pose><geometry><cylinder><radius>0.120</radius><length>0.005</length></cylinder></geometry><material><ambient>0.10 0.10 0.11 0.80</ambient><diffuse>0.22 0.22 0.24 0.80</diffuse></material></visual>
    </link>

    <joint name="rotor_front_right_joint" type="revolute">
      <parent>base_link</parent><child>rotor_front_right</child>
      <axis><xyz expressed_in="rotor_front_right">0 0 1</xyz><limit><effort>3</effort><velocity>1200</velocity></limit><dynamics><damping>0.00002</damping></dynamics></axis>
    </joint>
    <joint name="rotor_rear_left_joint" type="revolute">
      <parent>base_link</parent><child>rotor_rear_left</child>
      <axis><xyz expressed_in="rotor_rear_left">0 0 1</xyz><limit><effort>3</effort><velocity>1200</velocity></limit><dynamics><damping>0.00002</damping></dynamics></axis>
    </joint>
    <joint name="rotor_front_left_joint" type="revolute">
      <parent>base_link</parent><child>rotor_front_left</child>
      <axis><xyz expressed_in="rotor_front_left">0 0 1</xyz><limit><effort>3</effort><velocity>1200</velocity></limit><dynamics><damping>0.00002</damping></dynamics></axis>
    </joint>
    <joint name="rotor_rear_right_joint" type="revolute">
      <parent>base_link</parent><child>rotor_rear_right</child>
      <axis><xyz expressed_in="rotor_rear_right">0 0 1</xyz><limit><effort>3</effort><velocity>1200</velocity></limit><dynamics><damping>0.00002</damping></dynamics></axis>
    </joint>

    <!-- Provisional 9450/940 kV coefficients; they will be identified from a thrust stand. -->
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_front_right_joint</jointName><linkName>rotor_front_right</linkName>
      <turningDirection>ccw</turningDirection><timeConstantUp>0.012</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1050</maxRotVelocity><motorConstant>9.0e-6</motorConstant><momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>0</motorNumber>
      <rotorDragCoefficient>8.0e-5</rotorDragCoefficient><rollingMomentCoefficient>1.0e-6</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_rear_left_joint</jointName><linkName>rotor_rear_left</linkName>
      <turningDirection>ccw</turningDirection><timeConstantUp>0.012</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1050</maxRotVelocity><motorConstant>9.0e-6</motorConstant><momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>1</motorNumber>
      <rotorDragCoefficient>8.0e-5</rotorDragCoefficient><rollingMomentCoefficient>1.0e-6</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_front_left_joint</jointName><linkName>rotor_front_left</linkName>
      <turningDirection>cw</turningDirection><timeConstantUp>0.012</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1050</maxRotVelocity><motorConstant>9.0e-6</motorConstant><momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>2</motorNumber>
      <rotorDragCoefficient>8.0e-5</rotorDragCoefficient><rollingMomentCoefficient>1.0e-6</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-multicopter-motor-model-system" name="gz::sim::systems::MulticopterMotorModel">
      <jointName>rotor_rear_right_joint</jointName><linkName>rotor_rear_right</linkName>
      <turningDirection>cw</turningDirection><timeConstantUp>0.012</timeConstantUp><timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1050</maxRotVelocity><motorConstant>9.0e-6</motorConstant><momentConstant>0.016</momentConstant>
      <commandSubTopic>command/motor_speed</commandSubTopic><motorNumber>3</motorNumber>
      <rotorDragCoefficient>8.0e-5</rotorDragCoefficient><rollingMomentCoefficient>1.0e-6</rollingMomentCoefficient><rotorVelocitySlowdownSim>10</rotorVelocitySlowdownSim><motorType>velocity</motorType>
    </plugin>
  </model>
</sdf>
